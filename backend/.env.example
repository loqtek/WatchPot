# Copy to .env or run ../setup from the repository root.
# JWT, CORS, and most app settings live in the database after first API startup.

# Local helper Postgres (deploy/setup/docker-compose.postgres.yml on host port 5433):
DATABASE_URL=postgresql+asyncpg://watchpot:watchpot@127.0.0.1:5433/watchpot
# Docker compose stack (service hostname postgres):
# DATABASE_URL=postgresql+asyncpg://watchpot:watchpot@postgres:5432/watchpot
# Local helper MySQL (deploy/setup/docker-compose.mysql.yml on host port 3307):
# DATABASE_URL=mysql+aiomysql://watchpot:watchpot@127.0.0.1:3307/watchpot?charset=utf8mb4
# Browser API URL when building the web image — set in repo root .env (not here).
# Compose derives https://<WATCHPOT_PUBLIC_HOST>/api when NEXT_PUBLIC_API_URL is unset.
# NEXT_PUBLIC_API_URL=https://localhost/api

WATCHPOT_API_ROLE=control
WATCHPOT_STACK_MODE=full

# Local dev: with WATCHPOT_STACK_MODE=local_dev, ./run auto-starts the agent and
# registers a "local-pot" pot on first UI login. Disable with:
# WATCHPOT_AUTO_LOCAL_AGENT=false
#
# Docker compose enables auto local agent by default (see docker-compose.yml).

# Local dev without TLS proxy (./run + npm run dev only):
# WATCHPOT_CORS_ORIGINS=http://localhost:3020,http://127.0.0.1:3020
# WATCHPOT_EXTERNAL_LOG_PATHS_JSON=["/var/log/honeypots"]

# Local dev / lab (disabled by default; only enable when you intentionally need them):
# EXPOSE_OPENAPI=true
# WATCHPOT_ALLOW_LOOPBACK_CORS=true
# WATCHPOT_LOG_BOOTSTRAP_PASSWORD=true

# Production / VPC:
# EXPOSE_OPENAPI=false
# WATCHPOT_ALLOW_LOOPBACK_CORS=false
# WATCHPOT_LOG_BOOTSTRAP_PASSWORD=false
# WATCHPOT_METRICS_TOKEN=change-me
# WATCHPOT_MAX_BACKUP_UPLOAD_BYTES=536870912
# WATCHPOT_PUBLIC_AGENT_OPEN=false
# WATCHPOT_AGENT_ENROLLMENT_TOKEN=
# WATCHPOT_INTEGRATION_ALLOW_LOOPBACK=false
# WATCHPOT_AUTH_LOGIN_RATE_LIMIT=8
# WATCHPOT_AUTH_REGISTER_RATE_LIMIT=5
